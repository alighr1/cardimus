ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
HUBSPOT_TOKEN=
# SQLite file for users/sessions (default: data/cardimus.db)
DATABASE_PATH=data/cardimus.db

# Provider: "claude" (default) or "gemini" (free tier via https://aistudio.google.com/apikey)
AI_PROVIDER=claude
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Internal name of the HubSpot contact property for "Added by" (default: added_by)
HUBSPOT_ADDED_BY_PROPERTY=added_by
